# ─── Supabase ──────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ─── Payment Gateway: Yoco (primary — South African) ──────
# Yoco API secret key – used by the server to create checkouts
# Get yours from the Yoco Dashboard: https://dashboard.yoco.com
YOCO_SECRET_KEY=

# Yoco webhook secret – used to verify incoming webhook signatures
# Generate one in the Yoco Dashboard → Webhooks
YOCO_WEBHOOK_SECRET=

# ─── Payment Gateway: Stripe (optional fallback) ──────────
# Your Stripe secret key (starts with sk_live_ or sk_test_)
STRIPE_SECRET_KEY=

# Stripe webhook secret – used to verify webhook callbacks
STRIPE_WEBHOOK_SECRET=

# ─── Payments Server ──────────────────────────────────────
# The payments server origin (runs on localhost:4242 during dev)
# This is used by the frontend to create checkout sessions via Yoco/Stripe
VITE_PAYMENTS_SERVER_URL=http://localhost:4242

# URLs Yoco/Stripe redirect the user to after checkout
# NOTE: must match the /payment/return route registered in App.tsx
STRIPE_SUCCESS_URL=http://localhost:5173/payment/return
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancel

# ─── Payment Gateway: PayFast (redirect-based fallback) ───
# PayFast merchant credentials (sandbox or production)
VITE_PAYFAST_MERCHANT_ID=
VITE_PAYFAST_MERCHANT_KEY=

# "sandbox" (default) or "production"
VITE_PAYFAST_MODE=sandbox

# PayFast ITN (Instant Transaction Notification) URL
# Your server endpoint that receives PayFast payment confirmations
# For dev you can use ngrok or similar to expose localhost
VITE_PAYFAST_NOTIFY_URL=http://localhost:4242/payfast/notify

# ─── Supabase Service Role (for server-side webhooks) ─────
# Service role key with elevated permissions to update profiles
# Keep this secret – never expose on the frontend
SUPABASE_SERVICE_ROLE_KEY=

# ─── Server ────────────────────────────────────────────────
PORT=4242
